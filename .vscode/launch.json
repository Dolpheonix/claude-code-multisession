{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        // Claude Code uses the proposed API 'contribSecondarySidebar'; on VS Code builds that don't allow it,
        // the throw aborts view-container registration for every extension (all sidebars fall back to Explorer).
        "--enable-proposed-api",
        "Anthropic.claude-code"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
